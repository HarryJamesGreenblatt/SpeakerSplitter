<Window x:Class="SpeakerSplitter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeakerSplitter" Width="720" Height="480"
        MinWidth="500" MinHeight="360">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SelectedVisibility" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="SpeakerSplitter" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,16" TextWrapping="Wrap"
                   Text="Choose additional devices to mirror system audio. The default output keeps playing natively." />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Devices}"
                          AutomationProperties.AutomationId="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6,0,12">
                            <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected}"
                                  IsEnabled="{Binding CanSelect}"
                                  ToolTip="{Binding SelectionHint}"
                                  ToolTipService.ShowOnDisabled="True"
                                  AutomationProperties.Name="{Binding DisplayName}" />
                            <Grid Margin="24,8,0,0"
                                  Visibility="{Binding IsSelected, Converter={StaticResource SelectedVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="App-only volume" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Margin="12,0" Minimum="0" Maximum="100"
                                        Value="{Binding AppVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanAdjustVolume}"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ToolTip="Adjusts only SpeakerSplitter's stream. Windows device volume and other applications are unchanged."
                                        AutomationProperties.Name="{Binding VolumeLabel}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Text="{Binding AppVolumePercent, StringFormat={}{0:0}%}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Text="{Binding Status}"
                   TextWrapping="Wrap" AutomationProperties.AutomationId="Status" />
        <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal">
            <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}"
                    MinWidth="100" AutomationProperties.AutomationId="TogglePlayback" />
            <Button Content="Refresh Devices" Command="{Binding RefreshCommand}"
                    Margin="12,0,0,0" AutomationProperties.AutomationId="RefreshDevices" />
        </StackPanel>
    </Grid>
</Window>
